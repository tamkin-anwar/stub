# Stub. Copy this file to .env and fill in real values. Never commit .env.

# Supabase: create a free project at https://supabase.com/dashboard
# Project settings -> API -> Project URL and anon public key
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# TMDB: create a free account at https://www.themoviedb.org/settings/api
# Use the API Read Access Token (v4 auth, a long JWT starting with eyJ...)
VITE_TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# OMDb (optional): free key at https://www.omdbapi.com/apikey.aspx (1,000/day).
# Adds IMDb, Rotten Tomatoes and Metacritic scores on title pages. Leave blank
# to just show TMDB and an IMDb link.
VITE_OMDB_API_KEY=your-omdb-key
