# Stub. Copy this file to .env and fill in real values. Never commit .env.

# Supabase (required, client-side). Create a free project at
# https://supabase.com/dashboard, then Project settings -> API for these two.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# --- server-side only: read by the /api/* functions, never sent to the browser ---

# TMDB (required for the Library and Home). Free account at
# https://www.themoviedb.org/settings/api ; use the API Read Access Token
# (v4 auth, a long token starting with eyJ...).
TMDB_ACCESS_TOKEN=your-tmdb-v4-read-access-token

# OMDb (optional): free key at https://www.omdbapi.com/apikey.aspx (1,000/day,
# shared via the CDN cache). Adds IMDb / Rotten Tomatoes / Metacritic scores.
OMDB_API_KEY=your-omdb-key

# The Guardian Open Platform (optional): free key at
# https://open-platform.theguardian.com/access/ . Powers "In the press" on the
# home page. Leave blank to hide that section.
GUARDIAN_API_KEY=your-guardian-key

# Poster cache (optional). With all three of these set, /api/poster copies TMDB
# posters into a public Supabase Storage bucket so the grid stops depending on
# TMDB's CDN. Run supabase/migrations/0005_posters_bucket.sql first, then set
# VITE_POSTER_CACHE=1 to switch the client over. Leave unset to use TMDB URLs.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_URL is read from VITE_SUPABASE_URL above; set it explicitly only if
# you want a different value for the server.
VITE_POSTER_CACHE=
